<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UsesHammerUI>true</UsesHammerUI>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\Runesmith.Gitea\Runesmith.Gitea\Runesmith.Gitea.csproj" />
    <!-- The plugin leaves the SDK out of its output, since Runesmith provides it; the tests need their own copy. -->
    <ProjectReference Include="..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" />
  </ItemGroup>
  <!-- The tests of the API client, sign-in and accounts are the same for both plugins, so both run them. -->
  <ItemGroup>
    <Compile Include="..\Shared\Gitea\*.cs" LinkBase="Gitea" />
    <None Include="..\Shared\Gitea\Responses\*" LinkBase="Responses" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
