<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Runs the generator, the analyzer and the code fix as an IDE would. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <!-- Runs the CheckTranslations task with a build engine of the tests. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <!-- The Fluent runtime Runesmith uses, which the parser must agree with. -->
    <PackageReference Include="Linguini.Bundle" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Runesmith.Sdk.Analyzers\Runesmith.Sdk.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\Runesmith.Sdk.Analyzers.CodeFixes\Runesmith.Sdk.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="..\..\src\Runesmith.Sdk.Tasks\Runesmith.Sdk.Tasks.csproj" />
  </ItemGroup>
</Project>
