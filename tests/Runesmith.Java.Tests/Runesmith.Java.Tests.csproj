<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\Sdks\*.cs" LinkBase="Sdks\Shared" />
    <None Include="Sdks\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\Runesmith.Java\Runesmith.Java\Runesmith.Java.csproj" />
    <!-- The plugin leaves the SDK out of its output, since Runesmith provides it; the tests need their own copy. -->
    <ProjectReference Include="..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Runesmith.LanguageServices\Runesmith.LanguageServices.csproj" />
  </ItemGroup>
</Project>
