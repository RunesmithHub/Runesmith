    <ProjectReference Include="..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Runesmith.Text\Runesmith.Text.csproj" />
  </ItemGroup>
</Project>
