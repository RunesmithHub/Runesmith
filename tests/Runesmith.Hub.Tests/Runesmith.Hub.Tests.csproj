<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Runesmith.Hub\Runesmith.Hub.csproj" />
  </ItemGroup>
  <!-- A signed sample index from rshub dev fixture, served at the address its package links name. -->
  <ItemGroup>
    <Compile Include="..\Shared\Hub\*.cs" LinkBase="Shared" />
    <None Include="..\Shared\Hub\Index\**" LinkBase="HubIndex" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
