<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions listed here also apply to packages that come in transitively, so a vulnerable transitive package can be raised here. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <!-- The TextMate engine and its bundled grammars and themes must match. -->
    <TextMateSharpVersion>2.0.4</TextMateSharpVersion>
    <RoslynVersion>5.9.0</RoslynVersion>
  </PropertyGroup>
  <ItemGroup Label="User interface">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="HammerUI" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup Label="Composition">
    <PackageVersion Include="Microsoft.VisualStudio.Composition" Version="17.13.41" />
    <!-- Plugins share these with Runesmith, so the whole family has one version, new enough for the C# compiler's own composition. -->
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Convention" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Hosting" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Runtime" Version="10.0.12" />
    <PackageVersion Include="System.Composition.TypedParts" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- VS-MEF brings MessagePack 2.5.192, which has known vulnerabilities; 2.5.301 and later fix them. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="MessagePack.Annotations" Version="2.5.307" />
  </ItemGroup>
  <ItemGroup Label="Plugin hub">
    <PackageVersion Include="RunesmithHub.Protocol" Version="0.1.1" />
  </ItemGroup>
  <ItemGroup Label="Languages">
    <PackageVersion Include="TextMateSharp" Version="$(TextMateSharpVersion)" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="$(TextMateSharpVersion)" />
    <!-- The C# compiler and its features, which the C# analyzer hosts; one version for all its packages. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(RoslynVersion)" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Testing and measurement">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
