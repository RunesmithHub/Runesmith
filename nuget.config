<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The plugin hub's feed, for HammerUI and RunesmithHub.Protocol. Builds next to their checkouts use those instead and never query this source. -->
    <add key="RunesmithHub" value="https://nuget.runesmith.dev/index.json" />
  </packageSources>
  <!-- Vulnerability data comes from nuget.org, which carries the advisories for every package, wherever it was restored from. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="RunesmithHub">
      <package pattern="RunesmithHub.*" />
      <package pattern="HammerUI" />
    </packageSource>
  </packageSourceMapping>
</configuration>
