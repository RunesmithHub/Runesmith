<Project>
  <!-- Projects that set UsesHammerUI reference the HammerUI checkout beside this repository when there is one, so both can change together,
       and otherwise the HammerUI package. -->
  <ItemGroup Condition="'$(UsesHammerUI)' == 'true'">
    <ProjectReference Include="$(HammerUIProject)" Condition="Exists('$(HammerUIProject)')" />
    <PackageReference Include="HammerUI" Condition="!Exists('$(HammerUIProject)')" />
  </ItemGroup>

  <!-- Projects that set UsesHubProtocol reference the RunesmithHub.Protocol checkout when there is one, and otherwise its package. -->
  <ItemGroup Condition="'$(UsesHubProtocol)' == 'true'">
    <ProjectReference Include="$(HubProtocolProject)" Condition="Exists('$(HubProtocolProject)')" />
    <PackageReference Include="RunesmithHub.Protocol" Condition="!Exists('$(HubProtocolProject)')" />
  </ItemGroup>

  <!-- Published applications carry the licenses of what they ship in a licenses folder: Runesmith's own, and the license and notices
       files of every NuGet package that contributes files. -->
  <Target Name="PublishLicenses" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <ItemGroup>
      <_ShippedPackage Include="%(ResolvedFileToPublish.NuGetPackageId)" Version="%(ResolvedFileToPublish.NuGetPackageVersion)"
                       Condition="'%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_ShippedPackage)">
      <Output TaskParameter="Filtered" ItemName="_ShippedPackageOnce" />
    </RemoveDuplicates>
    <ItemGroup>
      <_ShippedPackageOnce Folder="$(NuGetPackageRoot)$([System.String]::Copy('%(Identity)').ToLowerInvariant())/%(Version)/" />
      <_PackageLicense Include="%(_ShippedPackageOnce.Folder)LICENSE*;%(_ShippedPackageOnce.Folder)License*;%(_ShippedPackageOnce.Folder)license*;%(_ShippedPackageOnce.Folder)THIRD-PARTY-NOTICES*;%(_ShippedPackageOnce.Folder)ThirdPartyNotices*;%(_ShippedPackageOnce.Folder)NOTICE*"
                       PackageId="%(_ShippedPackageOnce.Identity)" />
      <_RunesmithLicense Include="$(MSBuildThisFileDirectory)LICENSE;$(MSBuildThisFileDirectory)NOTICE" />
      <ResolvedFileToPublish Include="@(_PackageLicense)" RelativePath="licenses/%(_PackageLicense.PackageId)/%(_PackageLicense.Filename)%(_PackageLicense.Extension)"
                             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <ResolvedFileToPublish Include="@(_RunesmithLicense)" RelativePath="licenses/Runesmith/%(_RunesmithLicense.Filename)%(_RunesmithLicense.Extension)"
                             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" RelativePath="licenses/THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
