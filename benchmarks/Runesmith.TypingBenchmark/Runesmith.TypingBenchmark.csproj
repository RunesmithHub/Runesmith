<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A plugin that types into Runesmith's editor on a fixed schedule and reports how fast it responded.</Description>
    <IsPackable>false</IsPackable>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\Runesmith.Text\Runesmith.Text.csproj" Private="false" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
