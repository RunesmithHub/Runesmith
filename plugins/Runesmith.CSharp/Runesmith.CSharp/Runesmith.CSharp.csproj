<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>C# support for Runesmith: the language, the C# analyzer, the dotnet build provider and the .NET SDK provider.</Description>
    <!-- Runesmith supplies the SDK and everything it depends on, so none of it is copied next to the plugin. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <!-- A plugin carries its own libraries, such as the compiler, in its folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.CSharp.Contracts\Runesmith.CSharp.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\src\Runesmith.Text\Runesmith.Text.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\src\Runesmith.LanguageServices\Runesmith.LanguageServices.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- The analyzer and the compiler it hosts ship with the plugin. -->
    <ProjectReference Include="..\..\..\src\Runesmith.Languages.CSharp\Runesmith.Languages.CSharp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Transitive references are off, so the compiler packages the analyzer needs are listed here to ship with the plugin. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
  </ItemGroup>
  <ItemGroup>
    <!-- Downloading, checking and unpacking SDKs, shared with the other language plugins. -->
    <Compile Include="..\..\Shared\Sdks\*.cs" LinkBase="Sdks\Shared" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.CSharp.Tests" />
  </ItemGroup>
</Project>
