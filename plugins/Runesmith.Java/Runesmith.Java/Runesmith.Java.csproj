<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Java support for Runesmith: the language, the Java analyzer, the Maven and Gradle build provider and the JDK provider.</Description>
    <!-- Runesmith supplies the SDK and everything it depends on, so none of it is copied next to the plugin. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <!-- A plugin carries its own libraries in its folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.Java.Contracts\Runesmith.Java.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\src\Runesmith.Text\Runesmith.Text.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\src\Runesmith.LanguageServices\Runesmith.LanguageServices.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- The analyzer and the Java syntax it reads ship with the plugin. -->
    <ProjectReference Include="..\..\..\src\Runesmith.Languages.Java\Runesmith.Languages.Java.csproj" />
    <ProjectReference Include="..\..\..\src\Runesmith.Languages.Java.Syntax\Runesmith.Languages.Java.Syntax.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Downloading, checking and unpacking SDKs, shared with the other language plugins. -->
    <Compile Include="..\..\Shared\Sdks\*.cs" LinkBase="Sdks\Shared" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.Java.Tests" />
  </ItemGroup>
</Project>
