<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>GitHub in Runesmith: signing in to GitHub, and its repositories, links and pull requests for the Git plugin.</Description>
    <!-- Runesmith supplies the SDK, Avalonia, HammerUI and everything they depend on, so none of it is copied next to the plugin. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <UsesHostHammerUI>true</UsesHostHammerUI>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.GitHub.Contracts\Runesmith.GitHub.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Runesmith.Sdk\Runesmith.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- Avatars and the small view builders, shared with the Git plugin. -->
    <Compile Include="..\..\Shared\Views\*.cs" LinkBase="Views\Shared" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.GitHub.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The GitHub App Runesmith signs in as by default; a build of Runesmith can replace this file to ship its own app. -->
    <None Include="github-app.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
