<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Runesmith, the code editor.</Description>
    <AssemblyName>runesmith</AssemblyName>
    <RootNamespace>Runesmith.App</RootNamespace>
    <ApplicationIcon>Assets\runesmith.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UsesHammerUI>true</UsesHammerUI>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Plugins load this copy, never their own, so Runesmith ships it; the C# compiler services need it. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.Shell\Runesmith.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The logo's source; the icon sizes are made from it (see docs/branding.md). -->
    <None Include="Assets\runesmith.webp" />
    <!-- The plugin hub's trust root, the first root signed at the key ceremony; without it, the hub is not set up in this build. -->
    <None Include="Hub\root.json" Condition="Exists('Hub\root.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Linux installs copy share/ into ~/.local/share or /usr/share for the menu entry and its icons. -->
    <None Include="..\..\packaging\linux\share\**" LinkBase="share" CopyToPublishDirectory="PreserveNewest" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.App.Tests" />
  </ItemGroup>

  <!-- The official plugins Runesmith ships, pinned in bundled-plugins.json: tools/Runesmith.BundledPlugins fetches them from the plugin hub,
       checks them against its signed index and unpacks them, and they load like any other plugin from plugins/<id> next to the executable.
       Without a network connection, Debug builds leave out the plugins they have not fetched before; Release builds and publishing fail. -->
  <PropertyGroup>
    <BundledPluginsFile>$(MSBuildThisFileDirectory)../../bundled-plugins.json</BundledPluginsFile>
    <BundledPluginsTool>$(MSBuildThisFileDirectory)../../tools/Runesmith.BundledPlugins/Runesmith.BundledPlugins.csproj</BundledPluginsTool>
    <BundledPluginsCache>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)bundled-plugins</BundledPluginsCache>
  </PropertyGroup>
  <Target Name="BundlePlugins" AfterTargets="Build">
    <!-- Restoring the app does not restore the tool, which is not its reference; a fresh checkout restores it here. -->
    <MSBuild Projects="$(BundledPluginsTool)" Targets="Restore" Condition="!Exists('$(MSBuildThisFileDirectory)../../tools/Runesmith.BundledPlugins/obj/project.assets.json')"
             Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;_IsPublishing" />
    <MSBuild Projects="$(BundledPluginsTool)" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;_IsPublishing">
      <Output TaskParameter="TargetOutputs" PropertyName="_BundledPluginsToolPath" />
    </MSBuild>
    <PropertyGroup>
      <_DotnetHost>$(DOTNET_HOST_PATH)</_DotnetHost>
      <_DotnetHost Condition="'$(_DotnetHost)' == ''">dotnet</_DotnetHost>
      <_BundledPluginsRequired Condition="'$(Configuration)' == 'Release' or '$(_IsPublishing)' == 'true'"> --require</_BundledPluginsRequired>
    </PropertyGroup>
    <Exec Command="&quot;$(_DotnetHost)&quot; &quot;$(_BundledPluginsToolPath)&quot; &quot;$(BundledPluginsFile)&quot; &quot;$(MSBuildThisFileDirectory)Hub/root.json&quot; &quot;$(BundledPluginsCache)&quot;$(_BundledPluginsRequired)"
          StandardOutputImportance="high" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_BundledPluginsExitCode" />
    </Exec>
    <!-- The tool reports its own errors and then exits with 1; any other failure is a crash. -->
    <Error Condition="'$(_BundledPluginsExitCode)' != '0' and '$(_BundledPluginsExitCode)' != '1'" Text="Runesmith.BundledPlugins stopped with exit code $(_BundledPluginsExitCode)." />
    <ItemGroup>
      <_BundledPluginFile Include="$(BundledPluginsCache)/plugins/**/*" />
      <_StaleBundledPluginFile Include="$(OutDir)plugins/**/*" Exclude="@(_BundledPluginFile->'$(OutDir)plugins/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(_StaleBundledPluginFile)" />
    <Copy SourceFiles="@(_BundledPluginFile)" DestinationFiles="@(_BundledPluginFile->'$(OutDir)plugins/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBundledPlugins" AfterTargets="Publish" DependsOnTargets="BundlePlugins">
    <Copy SourceFiles="@(_BundledPluginFile)" DestinationFiles="@(_BundledPluginFile->'$(PublishDir)plugins/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
