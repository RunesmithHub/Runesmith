<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Runesmith, the code editor.</Description>
    <RunesmithLocalizable>true</RunesmithLocalizable>
    <AssemblyName>runesmith</AssemblyName>
    <RootNamespace>Runesmith.App</RootNamespace>
    <ApplicationIcon>Assets\runesmith.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UsesHammerUI>true</UsesHammerUI>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Plugins load this copy, never their own, so Runesmith ships it; the C# compiler services need it. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.Shell\Runesmith.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The logo's source; the icon sizes are made from it (see docs/branding.md). -->
    <None Include="Assets\runesmith.webp" />
    <!-- The plugin hub's trust root, the first root signed at the key ceremony; without it, the hub is not set up in this build. -->
    <None Include="Hub\root.json" Condition="Exists('Hub\root.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Linux installs copy share/ into ~/.local/share or /usr/share for the menu entry and its icons. -->
    <None Include="..\..\packaging\linux\share\**" LinkBase="share" CopyToPublishDirectory="PreserveNewest" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.App.Tests" />
  </ItemGroup>

  <!-- An incremental build can skip a project whose only change is its version and leave its older assembly in the output. -->
  <Target Name="CheckSharedAssemblyVersions" AfterTargets="Build">
    <ItemGroup>
      <_RunesmithSharedAssembly Include="$(OutDir)Runesmith.Sdk.dll;$(OutDir)Runesmith.Text.dll;$(OutDir)Runesmith.LanguageServices.dll" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(_RunesmithSharedAssembly)">
      <Output TaskParameter="Assemblies" ItemName="_RunesmithSharedIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'%(_RunesmithSharedIdentity.Version)' != '$(RunesmithSdkVersion).0'"
           Text="%(_RunesmithSharedIdentity.Name) in the output is version %(_RunesmithSharedIdentity.Version), and the plugin API is $(RunesmithSdkVersion). Rebuild the solution, such as with dotnet build --no-incremental." />
  </Target>
</Project>
