<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Plugins build against these packages from the hub feed: the SDK, the text buffer and the language services core. -->
    <IsPackable>false</IsPackable>
    <IsPackable Condition="'$(MSBuildProjectName)' == 'Runesmith.Sdk' or '$(MSBuildProjectName)' == 'Runesmith.Text' or '$(MSBuildProjectName)' == 'Runesmith.LanguageServices'">true</IsPackable>
    <Authors>Dylan de Beer</Authors>
    <Product>Runesmith</Product>
    <Copyright>Copyright 2026 Dylan de Beer</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RunesmithHub/Runesmith</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RunesmithHub/Runesmith</RepositoryUrl>
    <!-- Releases set RunesmithVersion from the tag, as an environment variable. -->
    <RunesmithVersion Condition="'$(RunesmithVersion)' == ''">0.1.0</RunesmithVersion>
    <!-- The version of the packages plugins build against, equal to RunesmithApi.Version; an sdk/v* tag must match it. -->
    <RunesmithSdkVersion Condition="'$(RunesmithSdkVersion)' == ''">0.1.2</RunesmithSdkVersion>
    <Version>$(RunesmithVersion)</Version>
    <Version Condition="'$(IsPackable)' == 'true'">$(RunesmithSdkVersion)</Version>
    <!-- The HammerUI and hub checkouts beside this one, used instead of their packages while they exist. -->
    <HammerUIProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../HammerUI/src/HammerUI/HammerUI.csproj'))</HammerUIProject>
    <HubProtocolProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../hub/src/RunesmithHub.Protocol/RunesmithHub.Protocol.csproj'))</HubProtocolProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and '$(IsBenchmarkProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CA1051;CA1716;CA1720</NoWarn>
  </PropertyGroup>

  <!-- Rejects calls that are easy to get wrong; BannedSymbols.txt says why for each one and what to use instead. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!-- Lets CI save a dump of a test run that hangs and stop it. Items see the project's own properties, so this reaches every test project. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>
</Project>
