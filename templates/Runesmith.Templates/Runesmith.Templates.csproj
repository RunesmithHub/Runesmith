<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Runesmith.Templates</PackageId>
    <Title>Runesmith templates</Title>
    <Description>Templates for Runesmith plugins: dotnet new runesmith-plugin.</Description>
    <PackageTags>runesmith;plugin;template;dotnet-new</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The package holds the template files only; there is no code to compile. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" PackagePath="%(Identity)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
