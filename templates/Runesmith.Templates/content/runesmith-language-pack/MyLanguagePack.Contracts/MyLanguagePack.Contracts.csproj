<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every plugin has a contracts project; a language pack's stays empty. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Runesmith.Sdk" Version="RUNESMITH_SDK_VERSION" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
