<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="RunesmithHub" value="https://nuget.runesmith.dev/index.json" />
  </packageSources>
  <!-- Vulnerability data comes from nuget.org, which carries the advisories for every package, wherever it was restored from. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <!-- Runesmith's SDK and plugin contracts come only from the plugin hub's feed, even after you add other sources. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="RunesmithHub">
      <package pattern="Runesmith.*" />
      <package pattern="RunesmithHub.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
